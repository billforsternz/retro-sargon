3055:			;***********************************************************
3056:			; INSERT PIECE SUBROUTINE
3057:			;***********************************************************
3058:			; FUNCTION:   --  This subroutine places a piece onto a
3059:			;                 given square on the video board. The piece
3060:			;                 inserted is that stored in the board array
3061:			;                 for that square.
