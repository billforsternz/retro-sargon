2531:			;***********************************************************
2532:			; BOARD INDEX TO ASCII SQUARE NAME
2533:			;***********************************************************
2534:			; FUNCTION:   --  To translate a hexadecimal index in the
2535:			;                 board array into an ascii description
2536:			;                 of the square in algebraic chess notation.
2537:			;
2538:			; CALLED BY:  --  CPTRMV
2539:			;
2540:			; CALLS:      --  DIVIDE
2541:			;
2542:			; ARGUMENTS:  --  Board index input in register D and the
2543:			;                 Ascii square name is output in register
2544:			;                 pair HL.
2545:			;***********************************************************
2546:	1C62  97      	BITASN: SUB     a               ; Get ready for division
2547:	1C63  1E0A    	        LD      e,10
2548:	1C65  CD0420  	        CALL    DIVIDE          ; Divide
2549:	1C68  15      	        DEC     d               ; Get rank on 1-8 basis
2550:	1C69  C660    	        ADD     a,60H           ; Convert file to Ascii (a-h)
2551:	1C6B  6F      	        LD      l,a             ; Save
2552:	1C6C  7A      	        LD      a,d             ; Rank
2553:	1C6D  C630    	        ADD     a,30H           ; Convert rank to Ascii (1-8)
2554:	1C6F  67      	        LD      h,a             ; Save
2555:	1C70  C9      	        RET                     ; Return
2556:			
2557:			;***********************************************************
2558:			; PLAYERS MOVE ANALYSIS
2559:			;***********************************************************
2560:			; FUNCTION:   --  To accept and validate the players move
2561:			;                 and produce it on the graphics board. Also
2562:			;                 allows player to resign the game by
2563:			;                 entering a control-R.
2564:			;
2565:			; CALLED BY:  --  DRIVER
2566:			;
2567:			; CALLS:      --  CHARTR
2568:			;                 ASNTBI
2569:			;                 VALMOV
2570:			;                 EXECMV
2571:			;                 PGIFND
2572:			;                 TBPLCL
2573:			;
2574:			; ARGUMENTS:  --  None
2575:			;***********************************************************
2576:	1C71  CD431D  	PLYRMV: CALL    CHARTR          ; Accept "from" file letter
2577:	1C74  FE12    	        CP      12H             ; Is it instead a Control-R ?
2578:	1C76  CAE91B  	        JP      Z,FM09          ; Yes - jump
2579:	1C79  67      	        LD      h,a             ; Save
2580:	1C7A  CD431D  	        CALL    CHARTR          ; Accept "from" rank number
2581:	1C7D  6F      	        LD      l,a             ; Save
2582:	1C7E  CDC71C  	        CALL    ASNTBI          ; Convert to a board index
2583:	1C81  90      	        SUB     b               ; Gives board index, if valid
2584:	1C82  2822    	        JR      Z,PL08          ; Jump if invalid
2585:	1C84  32B118  	        LD      (MVEMSG),a      ; Move list "from" position
2586:	1C87  CD431D  	        CALL    CHARTR          ; Accept separator & ignore it
2587:	1C8A  CD431D  	        CALL    CHARTR          ; Repeat for "to" position
2588:	1C8D  67      	        LD      h,a
2589:	1C8E  CD431D  	        CALL    CHARTR
2590:	1C91  6F      	        LD      l,a
2591:	1C92  CDC71C  	        CALL    ASNTBI
2592:	1C95  90      	        SUB     b
2593:	1C96  280E    	        JR      Z,PL08
2594:	1C98  32B218  	        LD      (MVEMSG+1),a    ; Move list "to" position
2595:	1C9B  CDEC1C  	        CALL    VALMOV          ; Determines if a legal move
2596:	1C9E  A7      	        AND     a               ; Legal ?
2597:	1C9F  C2A61C  	        JP      NZ,PL08         ; No - jump
2598:	1CA2  CD5E20  	        CALL    EXECMV          ; Make move on graphics board
2599:	1CA5  C9      	        RET                     ; Return
2600:	1CA6  215F19  	PL08:   LD      hl,LINECT       ; Address of screen line count
2601:	1CA9  34      	        INC     (hl)            ; Increase by 2 for message
2602:	1CAA  34      	        INC     (hl)
2603:	1CAB' FF921A00	        CARRET                  ; New line
	      00
2604:	1CB0  CD5D1D  	        CALL    PGIFND          ; New page if needed
2605:	1CB3' FFB21A44	        PRTLIN  INVAL1,12       ; Output "INVALID MOVE"
	      190C00
2606:	1CBA' FFB21A50	        PRTLIN  INVAL2,9        ; Output "TRY AGAIN"
	      190900
2607:	1CC1  CD121C  	        CALL    TBPLCL          ; Tab to players column
2608:	1CC4  C3711C  	        JP      PLYRMV          ; Jump
2609:			
2610:			;***********************************************************
2611:			; ASCII SQUARE NAME TO BOARD INDEX
2612:			;***********************************************************
2613:			; FUNCTION:   --  To convert an algebraic square name in
2614:			;                 Ascii to a hexadecimal board index.
2615:			;                 This routine also checks the input for
2616:			;                 validity.
2617:			;
2618:			; CALLED BY:  --  PLYRMV
2619:			;
2620:			; CALLS:      --  MLTPLY
2621:			;
2622:			; ARGUMENTS:  --  Accepts the square name in register pair HL
2623:			;                 and outputs the board index in register A.
2624:			;                 Register B = 0 if ok. Register B = Register
2625:			;                 A if invalid.
2626:			;***********************************************************
2627:	1CC7  7D      	ASNTBI: LD      a,l             ; Ascii rank (1 - 8)
2628:	1CC8  D630    	        SUB     30H             ; Rank 1 - 8
2629:	1CCA  FE01    	        CP      1               ; Check lower bound
2630:	1CCC  FAEA1C  	        JP      M,AT04          ; Jump if invalid
2631:	1CCF  FE09    	        CP      9               ; Check upper bound
2632:	1CD1  3017    	        JR      NC,AT04         ; Jump if invalid
2633:	1CD3  3C      	        INC     a               ; Rank 2 - 9
2634:	1CD4  57      	        LD      d,a             ; Ready for multiplication
2635:	1CD5  1E0A    	        LD      e,10
2636:	1CD7  CD1620  	        CALL    MLTPLY          ; Multiply
2637:	1CDA  7C      	        LD      a,h             ; Ascii file letter (a - h)
2638:	1CDB  D640    	        SUB     40H             ; File 1 - 8
2639:	1CDD  FE01    	        CP      1               ; Check lower bound
2640:	1CDF  FAEA1C  	        JP      M,AT04          ; Jump if invalid
2641:	1CE2  FE09    	        CP      9               ; Check upper bound
2642:	1CE4  3004    	        JR      NC,AT04         ; Jump if invalid
2643:	1CE6  82      	        ADD     a,d             ; File+Rank(20-90)=Board index
2644:	1CE7  0600    	        LD      b,0             ; Ok flag
2645:	1CE9  C9      	        RET                     ; Return
2646:	1CEA  47      	AT04:   LD      b,a             ; Invalid flag
2647:	1CEB  C9      	        RET                     ; Return
2648:			
2649:			;***********************************************************
2650:			; VALIDATE MOVE SUBROUTINE
2651:			;***********************************************************
2652:			; FUNCTION:   --  To check a players move for validity.
2653:			;
2654:			; CALLED BY:  --  PLYRMV
2655:			;
2656:			; CALLS:      --  GENMOV
2657:			;                 MOVE
2658:			;                 INCHK
2659:			;                 UNMOVE
2660:			;
2661:			; ARGUMENTS:  --  Returns flag in register A, 0 for valid
2662:			;                 and 1 for invalid move.
2663:			;***********************************************************
2664:	1CEC  2A1600  	VALMOV: LD      hl,(MLPTRJ)     ; Save last move pointer
2665:	1CEF  E5      	        PUSH    hl              ; Save register
2666:	1CF0  3A2000  	        LD      a,(KOLOR)       ; Computers color
2667:	1CF3  EE80    	        XOR     80H             ; Toggle color
2668:	1CF5  322100  	        LD      (COLOR),a       ; Store
2669:	1CF8  215D01  	        LD      hl,PLYIX-2      ; Load move list index
2670:	1CFB  221400  	        LD      (MLPTRI),hl
2671:	1CFE  210007  	        LD      hl,MLIST+1024   ; Next available list pointer
2672:	1D01  221E00  	        LD      (MLNXT),hl
2673:	1D04  CD560D  	        CALL    GENMOV          ; Generate opponents moves
2674:	1D07  DD210007	        LD      ix,MLIST+1024   ; Index to start of moves
2675:	1D0B  3AB118  	VA5:    LD      a,(MVEMSG)      ; "From" position
2676:	1D0E  DDBE02  	        CP      (ix+MLFRP)      ; Is it in list ?
2677:	1D11  2008    	        JR      NZ,VA6          ; No - jump
2678:	1D13  3AB218  	        LD      a,(MVEMSG+1)    ; "To" position
2679:	1D16  DDBE03  	        CP      (ix+MLTOP)      ; Is it in list ?
2680:	1D19  280F    	        JR      Z,VA7           ; Yes - jump
2681:	1D1B  DD5E00  	VA6:    LD      e,(ix+MLPTR)    ; Pointer to next list move
2682:	1D1E  DD5601  	        LD      d,(ix+MLPTR+1)
2683:	1D21  AF      	        XOR     a               ; At end of list ?
2684:	1D22  BA      	        CP      d
2685:	1D23  2817    	        JR      Z,VA10          ; Yes - jump
2686:	1D25  D5      	        PUSH    de              ; Move to X register
2687:	1D26  DDE1    	        POP     ix
2688:	1D28  18E1    	        JR      VA5             ; Jump
2689:	1D2A  DD221600	VA7:    LD      (MLPTRJ),ix     ; Save opponents move pointer
2690:	1D2E  CD7111  	        CALL    MOVE            ; Make move on board array
2691:	1D31  CD980D  	        CALL    INCHK           ; Was it a legal move ?
2692:	1D34  A7      	        AND     a
2693:	1D35  2002    	        JR      NZ,VA9          ; No - jump
2694:	1D37  E1      	VA8:    POP     hl              ; Restore saved register
2695:	1D38  C9      	        RET                     ; Return
2696:	1D39  CDE311  	VA9:    CALL    UNMOVE          ; Un-do move on board array
2697:	1D3C  3E01    	VA10:   LD      a,1             ; Set flag for invalid move
2698:	1D3E  E1      	        POP     hl              ; Restore saved register
2699:	1D3F  221600  	        LD      (MLPTRJ),hl     ; Save move pointer
2700:	1D42  C9      	        RET                     ; Return
2701:			
2702:			;***********************************************************
2703:			; ACCEPT INPUT CHARACTER
2704:			;***********************************************************
2705:			; FUNCTION:   --  Accepts a single character input from the
2706:			;                 console keyboard and places it in the A
2707:			;                 register. The character is also echoed on
2708:			;                 the video screen, unless it is a carriage
2709:			;                 return, line feed, or backspace.
2710:			;                 Lower case alphabetic characters are folded
2711:			;                 to upper case.
2712:			;
2713:			; CALLED BY:  --  DRIVER
2714:			;                 INTERR
2715:			;                 PLYRMV
2716:			;                 ANALYS
2717:			;
2718:			; CALLS:      --  None
2719:			;
2720:			; ARGUMENTS:  --  Character input is output in register A.
2721:			;
2722:			; NOTES:      --  This routine contains a reference to a
2723:			;                 monitor function of the Jove monitor, there-
2724:			;                 for the first few lines of this routine are
2725:			;                 system dependent.
2726:			;***********************************************************
2727:	1D43  FF      	CHARTR: RST     38h             ; Jove monitor single char inpt
2728:	1D44  8100    	        DB      81H,0
2729:	1D46  FE0D    	        CP      0DH             ; Carriage return ?
2730:	1D48  C8      	        RET     Z               ; Yes - return
2731:	1D49  FE0A    	        CP      0AH             ; Line feed ?
2732:	1D4B  C8      	        RET     Z               ; Yes - return
2733:	1D4C  FE08    	        CP      08H             ; Backspace ?
2734:	1D4E  C8      	        RET     Z               ; Yes - return
2735:	1D4F  FF      	        RST     38h             ; Jove monitor single char echo
2736:	1D50  811A    	        DB      81H,1AH
2737:	1D52  E67F    	        AND     7FH             ; Mask off parity bit
2738:	1D54  FE7B    	        CP      7BH             ; Upper range check (z+l)
2739:	1D56  F0      	        RET     P               ; No need to fold - return
2740:	1D57  FE61    	        CP      61H             ; Lower-range check (a)
2741:	1D59  F8      	        RET     M               ; No need to fold - return
2742:	1D5A  D620    	        SUB     20H             ; Change to one of A-Z
2743:	1D5C  C9      	        RET                     ; Return
2744:			
2745:			;***********************************************************
2746:			; NEW PAGE IF NEEDED
2747:			;***********************************************************
2748:			; FUNCTION:   --  To clear move list output when the column
2749:			;                 has been filled.
2750:			;
2751:			; CALLED BY:  --  DRIVER
2752:			;                 PLYRMV
2753:			;                 CPTRMV
2754:			;
2755:			; CALLS:     --   DSPBRD
2756:			;
2757:			; ARGUMENTS: --   Returns a 1 in the A register if a new
2758:			;                 page was turned.
2759:			;***********************************************************
2760:	1D5D  215F19  	PGIFND: LD      hl,LINECT       ; Addr of page position counter
2761:	1D60  34      	        INC     (hl)            ; Increment
2762:	1D61  3E1B    	        LD      a,1BH           ; Page bottom ?
2763:	1D63  BE      	        CP      (hl)
2764:	1D64  D0      	        RET     NC              ; No - return
2765:	1D65  CDDB1E  	        CALL    DSPBRD          ; Put up new page
2766:	1D68' FFB21A1B	        PRTLIN  TITLE4,15       ; Re-print titles
	      190F00
2767:	1D6F' FFB21A89	        PRTLIN  TITLE3,15
	      180F00
2768:	1D76  3E01    	        LD      a,1             ; Set line count back to 1
2769:	1D78  325F19  	        LD      (LINECT),a
2770:	1D7B  C9      	        RET                     ; Return
2771:			
2772:			;***********************************************************
2773:			; DISPLAY MATED KING
2774:			;***********************************************************
2775:			; FUNCTION:   --  To tip over the computers King when
2776:			;                 mated.
2777:			;
2778:			; CALLED BY:  --  FCDMAT
2779:			;
2780:			; CALLS:      --  CONVRT
2781:			;                 BLNKER
2782:			;                 INSPCE  (Abnormal Call to IP04)
2783:			;
2784:			; ARGUMENTS:  --  None
2785:			;***********************************************************
2786:	1D7C  3A2000  	MATED:  LD      a,(KOLOR)       ; Computers color
2787:	1D7F  A7      	        AND     a               ; Is computer white ?
2788:	1D80  2807    	        JR      Z,rel23         ; Yes - skip
2789:	1D82  0E02    	        LD      c,2             ; Set black piece flag
2790:	1D84  3A4F01  	        LD      a,(POSK+1)      ; Position of black King
2791:	1D87  1804    	        JR      MA08            ; Jump
2792:	1D89  4F      	rel23:  LD      c,a             ; Clear black piece flag
2793:	1D8A  3A4E01  	        LD      a,(POSK)        ; Position of white King
2794:	1D8D  325919  	MA08:   LD      (BRDPOS),a      ; Store King position
2795:	1D90  325A19  	        LD      (ANBDPS),a      ; Again
2796:	1D93  CDE01F  	        CALL    CONVRT          ; Getting norm address in HL
2797:	1D96  3E07    	        LD      a,7             ; Piece value of toppled King
2798:	1D98  060A    	        LD      b,10            ; Blink parameter
2799:	1D9A  CD2720  	        CALL    BLNKER          ; Blink King position
2800:	1D9D  FD21AC1D	        LD      iy,MA0C         ; Prepare for abnormal call
2801:	1DA1  FDE5    	        PUSH    iy
2802:	1DA3  E5      	        PUSH    hl
2803:	1DA4  C5      	        PUSH    bc
2804:	1DA5  D5      	        PUSH    de
2805:	1DA6  DDE5    	        PUSH    ix
2806:	1DA8  F5      	        PUSH    af
2807:	1DA9  C3691F  	        JP      IP04            ; Call INSPCE
2808:	1DAC  060A    	MA0C:   LD      b,10            ; Blink again
2809:	1DAE  3A5A19  	        LD      a,(ANBDPS)
2810:	1DB1  325919  	        LD      (BRDPOS),a
2811:	1DB4  CD2720  	        CALL    BLNKER
2812:	1DB7  C9      	        RET                     ; Return
2813:			
2814:			;***********************************************************
2815:			; SET UP POSITION FOR ANALYSIS
2816:			;***********************************************************
2817:			; FUNCTION:   --  To enable user to set up any position
2818:			;                 for analysis, or to continue to play
2819:			;                 the game. The routine blinks the board
2820:			;                 squares in turn and the user has the option
2821:			;                 of leaving the contents unchanged by a
2822:			;                 carriage return, emptying the square by a 0,
2823:			;                 or inputting a piece of his chosing. To
2824:			;                 enter a piece, type in piece-code,color-code,
2825:			;                 moved-code.
2826:			;
2827:			;                 Piece-code is a letter indicating the
2828:			;                 desired piece:
2829:			;                       K  -  King
2830:			;                       Q  -  Queen
2831:			;                       R  -  Rook
2832:			;                       B  -  Bishop
2833:			;                       N  -  Knight
2834:			;                       P  -  Pawn
2835:			;
2836:			;                 Color code is a letter, W for white, or B for
2837:			;                 black.
2838:			;
2839:			;                 Moved-code is a number. 0 indicates the piece has never
2840:			;                 moved. 1 indicates the piece has moved.
2841:			;
2842:			;                 A backspace will back up in the sequence of blinked
2843:			;                 squares. An Escape will terminate the blink cycle and
2844:			;                 verify that the position is correct, then procede
2845:			;                 with game initialization.
2846:			;
2847:			; CALLED BY:  --  DRIVER
2848:			;
2849:			; CALLS:      --  CHARTR
2850:			;                 DPSBRD
2851:			;                 BLNKER
2852:			;                 ROYALT
2853:			;                 PLYRMV
2854:			;                 CPTRMV
2855:			;
2856:			; MACRO CALLS:    PRTLIN
2857:			;                 EXIT
2858:			;                 CLRSCR
2859:			;                 PRTBLK
2860:			;                 CARRET
2861:			;
2862:			; ARGUMENTS:  --  None
2863:			;***********************************************************
2864:	1DB8' FFB21A22	ANALYS: PRTLIN  ANAMSG,37       ; "CARE TO ANALYSE A POSITION?"
	      182500
2865:	1DBF  CD431D  	        CALL    CHARTR          ; Accept answer
2866:	1DC2' FF921A00	        CARRET                  ; New line
	      00
2867:	1DC7  FE4E    	        CP      4EH             ; Is answer a "N" ?
2868:	1DC9  2002    	        JR      NZ,AN04         ; No - jump
2869:	1DCB' FF1F    	        EXIT                    ; Return to monitor
2870:	1DCD  CDDB1E  	AN04:   CALL    DSPBRD          ; Current board position
2871:	1DD0  3E15    	        LD      a,21            ; First board index
2872:	1DD2  325A19  	AN08:   LD      (ANBDPS),a      ; Save
2873:	1DD5  325919  	        LD      (BRDPOS),a
2874:	1DD8  CDE01F  	        CALL    CONVRT          ; Norm address into HL register
2875:	1DDB  320000  	        LD      (M1),a          ; Set up board index
2876:	1DDE  DD2A0000	        LD      ix,(M1)
2877:	1DE2  DD7EB4  	        LD      a,(ix+BOARD)    ; Get board contents
2878:	1DE5  FEFF    	        CP      0FFH            ; Border square ?
2879:	1DE7  283C    	        JR      Z,AN19          ; Yes - jump
2880:	1DE9  0604    	        LD      b,4H            ; Ready to blink square
2881:	1DEB  CD2720  	        CALL    BLNKER          ; Blink
2882:	1DEE  CD431D  	        CALL    CHARTR          ; Accept input
2883:	1DF1  FE1B    	        CP      1BH             ; Is it an escape ?
2884:	1DF3  2849    	        JR      Z,AN1B          ; Yes - jump
2885:	1DF5  FE08    	        CP      08H             ; Is it a backspace ?
2886:	1DF7  2836    	        JR      Z,AN1A          ; Yes - jump
2887:	1DF9  FE0D    	        CP      0DH             ; Is it a carriage return ?
2888:	1DFB  2828    	        JR      Z,AN19          ; Yes - jump
2889:	1DFD  010700  	        LD      bc,7            ; Number of types of pieces + 1
2890:	1E00  21CE18  	        LD      hl,PCS          ; Address of piece symbol table
2891:	1E03  EDB1    	        CPIR                    ; Search
2892:	1E05  2018    	        JR      NZ,AN18         ; Jump if not found
2893:	1E07  CD431D  	        CALL    CHARTR          ; Accept and ignore separator
2894:	1E0A  CD431D  	        CALL    CHARTR          ; Color of piece
2895:	1E0D  FE42    	        CP      42H             ; Is it black ?
2896:	1E0F  2002    	        JR      NZ,rel022       ; No - skip
2897:	1E11  CBF9    	        SET     7,c             ; Black piece indicator
2898:	1E13  CD431D  	rel022: CALL    CHARTR          ; Accept and ignore separator
2899:	1E16  CD431D  	        CALL    CHARTR          ; Moved flag
2900:	1E19  FE31    	        CP      31H             ; Has piece moved ?
2901:	1E1B  2002    	        JR      NZ,AN18         ; No - jump
2902:	1E1D  CBD9    	        SET     3,c             ; Set moved indicator
2903:	1E1F  DD71B4  	AN18:   LD      (ix+BOARD),c    ; Insert piece into board array
2904:	1E22  CDDB1E  	        CALL    DSPBRD          ; Update graphics board
2905:	1E25  3A5A19  	AN19:   LD      a,(ANBDPS)      ; Current board position
2906:	1E28  3C      	        INC     a               ; Next
2907:	1E29  FE63    	        CP      99              ; Done ?
2908:	1E2B  20A5    	        JR      NZ,AN08         ; No - jump
2909:	1E2D  189E    	        JR      AN04            ; Jump
2910:	1E2F  3A5A19  	AN1A:   LD      a,(ANBDPS)      ; Prepare to go back a square
2911:	1E32  D603    	        SUB     3               ; To get around border
2912:	1E34  FE14    	        CP      20              ; Off the other end ?
2913:	1E36  D2D21D  	        JP      NC,AN08         ; No - jump
2914:	1E39  3E62    	        LD      a,98            ; Wrap around to top of screen
2915:	1E3B  C3D21D  	AN0B:   JP      AN08            ; Jump
2916:	1E3E' FFB21AF6	AN1B:   PRTLIN  CRTNES,14       ; Ask if correct
	      180E00
2917:	1E45  CD431D  	        CALL    CHARTR          ; Accept answer
2918:	1E48  FE4E    	        CP      4EH             ; Is it "N" ?
2919:	1E4A  CACD1D  	        JP      Z,AN04          ; No - jump
2920:	1E4D  CDA41E  	        CALL    ROYALT          ; Update positions of royalty
2921:	1E50' FFB21A3C	        CLRSCR                  ; Blank screen
	      190100
2922:	1E57  CDB91A  	        CALL    INTERR          ; Accept color choice
2923:	1E5A' FFB21A2B	AN1C:   PRTLIN  WSMOVE,17       ; Ask whose move it is
	      191100
2924:	1E61  CD431D  	        CALL    CHARTR          ; Accept response
2925:	1E64  CDDB1E  	        CALL    DSPBRD          ; Display graphics board
2926:	1E67' FFB21A1B	        PRTLIN  TITLE4,15       ; Put up titles
	      190F00
2927:	1E6E' FFB21A89	        PRTLIN  TITLE3,15
	      180F00
2928:	1E75  FE57    	        CP      57H             ; Is is whites move ?
2929:	1E77  CA4C1A  	        JP      Z,DRIV04        ; Yes - jump
2930:	1E7A' FFB31A86	        PRTBLK  MVENUM,3        ; Print move number
	      180300
2931:	1E81' FFB31A7C	        PRTBLK  SPACE,6         ; Tab to blacks column
	      180600
2932:	1E88  3A2000  	        LD      a,(KOLOR)       ; Computer's color
2933:	1E8B  A7      	        AND     a               ; Is computer white ?
2934:	1E8C  200B    	        JR      NZ,AN20         ; No - jump
2935:	1E8E  CD711C  	        CALL    PLYRMV          ; Get players move
2936:	1E91' FF921A00	        CARRET                  ; New line
	      00
2937:	1E96  C38F1A  	        JP      DR0C            ; Jump
2938:	1E99  CD211B  	AN20:   CALL    CPTRMV          ; Get computers move
2939:	1E9C' FF921A00	        CARRET                  ; New line
	      00
2940:	1EA1  C38F1A  	        JP      DR0C            ; Jump
2941:			
2942:			;***********************************************************
2943:			; UPDATE POSITIONS OF ROYALTY
2944:			;***********************************************************
2945:			; FUNCTION:   --  To update the positions of the Kings
2946:			;                 and Queen after a change of board position
2947:			;                 in ANALYS.
2948:			;
2949:			; CALLED BY:  --  ANALYS
2950:			;
2951:			; CALLS:      --  None
2952:			;
2953:			; ARGUMENTS:  --  None
2954:			;***********************************************************
2955:	1EA4  214E01  	ROYALT: LD      hl,POSK         ; Start of Royalty array
2956:	1EA7  0604    	        LD      b,4             ; Clear all four positions
2957:	1EA9  3600    	back06: LD      (hl),0
2958:	1EAB  23      	        INC     hl
2959:	1EAC  10FB    	        DJNZ    back06
2960:	1EAE  3E15    	        LD      a,21            ; First board position
2961:	1EB0  320000  	RY04:   LD      (M1),a          ; Set up board index
2962:	1EB3  214E01  	        LD      hl,POSK         ; Address of King position
2963:	1EB6  DD2A0000	        LD      ix,(M1)
2964:	1EBA  DD7EB4  	        LD      a,(ix+BOARD)    ; Fetch board contents
2965:	1EBD  CB7F    	        BIT     7,a             ; Test color bit
2966:	1EBF  2801    	        JR      Z,rel023        ; Jump if white
2967:	1EC1  23      	        INC     hl              ; Offset for black
2968:	1EC2  E607    	rel023: AND     7               ; Delete flags, leave piece
2969:	1EC4  FE06    	        CP      KING            ; King ?
2970:	1EC6  2806    	        JR      Z,RY08          ; Yes - jump
2971:	1EC8  FE05    	        CP      QUEEN           ; Queen ?
2972:	1ECA  2006    	        JR      NZ,RY0C         ; No - jump
2973:	1ECC  23      	        INC     hl              ; Queen position
2974:	1ECD  23      	        INC     hl              ; Plus offset
2975:	1ECE  3A0000  	RY08:   LD      a,(M1)          ; Index
2976:	1ED1  77      	        LD      (hl),a          ; Save
2977:	1ED2  3A0000  	RY0C:   LD      a,(M1)          ; Current position
2978:	1ED5  3C      	        INC     a               ; Next position
2979:	1ED6  FE63    	        CP      99              ; Done.?
2980:	1ED8  20D6    	        JR      NZ,RY04         ; No - jump
2981:	1EDA  C9      	        RET                     ; Return
2982:			
2983:			;***********************************************************
2984:			; SET UP EMPTY BOARD
2985:			;***********************************************************
2986:			; FUNCTION:   --  Display graphics board and pieces.
2987:			;
2988:			; CALLED BY:  --  DRIVER
2989:			;                 ANALYS
2990:			;                 PGIFND
2991:			;
2992:			; CALLS:      --  CONVRT
2993:			;                 INSPCE
2994:			;
2995:			; ARGUMENTS:  --  None
2996:			;
2997:			; NOTES:      --  This routine makes use of several fixed
2998:			;                 addresses in the video storage area of
2999:			;                 the Jupiter III computer, and is therefor
3000:			;                 system dependent. Each such reference will
3001:			;                 be marked.
3002:			;***********************************************************
3003:	1EDB  C5      	DSPBRD: PUSH    bc              ; Save registers
3004:	1EDC  D5      	        PUSH    de
3005:	1EDD  E5      	        PUSH    hl
3006:	1EDE  F5      	        PUSH    af
3007:	1EDF' FFB21A3C	        CLRSCR                  ; Blank screen
	      190100
3008:	1EE6  2100C0  	        LD      hl,0C000H       ; System Dependent-First video
3009:			                                ; address
3010:	1EE9  3680    	        LD      (hl),80H        ; Start of blank border
3011:	1EEB  1101C0  	        LD      de,0C001H       ; Sys Dep- Next border square
3012:	1EEE  010F00  	        LD      bc,15           ; Number of bytes to be moved
3013:	1EF1  EDB0    	        LDIR                    ; Blank border bar
3014:	1EF3  36AA    	        LD      (hl),0AAH       ; First black border box
3015:	1EF5  2C      	        INC     l               ; Next block address
3016:	1EF6  0606    	        LD      b,6             ; Number to be moved
3017:	1EF8  3680    	DB04:   LD      (hl),80H        ; Create white block
3018:	1EFA  2C      	        INC     l               ; Next block address
3019:	1EFB  10FB    	        DJNZ    DB04            ; Done ? No - jump
3020:	1EFD  0606    	        LD      b,6             ; Number of repeats
3021:	1EFF  36BF    	DB08:   LD      (hl),0BFH       ; Create black box ???
3022:	1F01  2C      	        INC     l               ; Next block address
3023:	1F02  10FB    	        DJNZ    DB08            ; Done ? No - jump
3024:	1F04  EB      	        EX      de,hl           ; Get ready for block move
3025:	1F05  012400  	        LD      bc,36           ; Bytes to be moved
3026:	1F08  EDB0    	        LDIR                    ; Move - completes first bar
3027:	1F0A  2100C0  	        LD      hl,0C000H       ; S D - First addr to be copied
