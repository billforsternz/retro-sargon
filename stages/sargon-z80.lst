1937:	13FA  CB7F    	        BIT     7,a             ; Is it white ?
1938:	13FC  C8      	        RET     Z               ; Yes - return
1939:	13FD  212500  	        LD      hl,PMATE        ; Checkmate move number
1940:	1400  35      	        DEC     (hl)            ; Decrement
1941:	1401  C9      	        RET                     ; Return
