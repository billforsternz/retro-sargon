3156:			;***********************************************************
3157:			; BOARD INDEX TO NORM ADDRESS SUBR.
3158:			;***********************************************************
3159:			; FUNCTION:   --  Converts a hexadecimal board index into
3160:			;                 a Norm address for the square.
3161:			;
3162:			; CALLED BY:  --  DSPBRD
3163:			;                 INSPCE
3164:			;                 ANALYS
3165:			;                 MATED
3166:			;
3167:			; CALLS:      --  DIVIDE
3168:			;                 MLTPLY
3169:			;
3170:			; ARGUMENTS:   -- Returns the Norm address in register pair
3171:			;                 HL.
3172:			;***********************************************************
3173:	1FE0  C5      	CONVRT: PUSH    bc              ; Save registers
3174:	1FE1  D5      	        PUSH    de
3175:	1FE2  F5      	        PUSH    af
3176:	1FE3  3A5919  	        LD      a,(BRDPOS)      ; Get board index
3177:	1FE6  57      	        LD      d,a             ; Set up dividend
3178:	1FE7  97      	        SUB     a
3179:	1FE8  1E0A    	        LD      e,10            ; Divisor
3180:	1FEA  CD0420  	        CALL    DIVIDE          ; Index into rank and file
3181:			                                ; file (1-8) & rank (2-9)
3182:	1FED  15      	        DEC     d               ; For rank (1-8)
3183:	1FEE  3D      	        DEC     a               ; For file (0-7)
3184:	1FEF  4A      	        LD      c,d             ; Save
3185:	1FF0  1606    	        LD      d,6             ; Multiplier
3186:	1FF2  5F      	        LD      e,a             ; File number is multiplicand
3187:	1FF3  CD1620  	        CALL    MLTPLY          ; Giving file displacement
3188:	1FF6  7A      	        LD      a,d             ; Save
3189:	1FF7  C610    	        ADD     a,10H           ; File norm address
3190:	1FF9  6F      	        LD      l,a             ; Low order address byte
3191:	1FFA  3E08    	        LD      a,8             ; Rank adjust
3192:	1FFC  91      	        SUB     c               ; Rank displacement
3193:	1FFD  C6C0    	        ADD     a,0C0H          ; Rank Norm address
3194:	1FFF  67      	        LD      h,a             ; High order addres byte
3195:	2000  F1      	        POP     af              ; Restore registers
3196:	2001  D1      	        POP     de
3197:	2002  C1      	        POP     bc
3198:	2003  C9      	        RET                     ; Return
