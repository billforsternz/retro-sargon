2329:			;***********************************************************
2330:			; COMPUTER MOVE ROUTINE
2331:			;***********************************************************
2332:			; FUNCTION:   --  To control the search for the computers move
2333:			;                 and the display of that move on the board
2334:			;                 and in the move list.
2335:			;
2336:			; CALLED BY:  --  DRIVER
2337:			;
2338:			; CALLS:      --  FNDMOV
2339:			;                 FCDMAT
2340:			;                 MOVE
2341:			;                 EXECMV
2342:			;                 BITASN
2343:			;                 INCHK
2344:			;
2345:			; MACRO CALLS:    PRTBLK
2346:			;                 CARRET
2347:			;
2348:			; ARGUMENTS:  --  None
2349:			;***********************************************************
2350:	1B21  CDB612  	CPTRMV: CALL    FNDMOV          ; Select best move
2351:	1B24  2A1A00  	        LD      hl,(BESTM)      ; Move list pointer variable
2352:	1B27  221600  	        LD      (MLPTRJ),hl     ; Pointer to move data
2353:	1B2A  3A5401  	        LD      a,(SCORE+1)     ; To check for mates
2354:	1B2D  FE01    	        CP      1               ; Mate against computer ?
2355:	1B2F  2005    	        JR      NZ,CP0C         ; No - jump
2356:	1B31  0E01    	        LD      c,1             ; Computer mate flag
2357:	1B33  CDAF1B  	        CALL    FCDMAT          ; Full checkmate ?
2358:	1B36  CD7111  	CP0C:   CALL    MOVE            ; Produce move on board array
2359:	1B39  CD5E20  	        CALL    EXECMV          ; Make move on graphics board
2360:			                                ; and return info about it
2361:	1B3C  78      	        LD      a,b             ; Special move flags
2362:	1B3D  A7      	        AND     a               ; Special ?
2363:	1B3E  2017    	        JR      NZ,CP10         ; Yes - jump
2364:	1B40  53      	        LD      d,e             ; "To" position of the move
2365:	1B41  CD621C  	        CALL    BITASN          ; Convert to Ascii
2366:	1B44  22B418  	        LD      (MVEMSG+3),hl   ; Put in move message
2367:	1B47  51      	        LD      d,c             ; "From" position of the move
2368:	1B48  CD621C  	        CALL    BITASN          ; Convert to Ascii
2369:	1B4B  22B118  	        LD      (MVEMSG),hl     ; Put in move message
2370:	1B4E' FFB31AB1	        PRTBLK  MVEMSG,5        ; Output text of move
	      180500
