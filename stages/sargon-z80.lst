3063:			; CALLED BY:  --  DPSPRD
3064:			;                 MATED
3065:			;
3066:			; CALLS:      --  MLTPLY
3067:			;
3068:			; ARGUMENTS:  --  Norm address for the square in register
3069:			;                 pair HL.
3070:			;***********************************************************
3071:	1F47  E5      	INSPCE: PUSH    hl              ; Save registers
3072:	1F48  C5      	        PUSH    bc
