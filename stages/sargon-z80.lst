1292:	0FE3  C8      	        RET     Z               ; Return if none
1293:	0FE4  6F      	        LD      l,a             ; Save attacker value
1294:	0FE5  CDFA0F  	        CALL    NEXTAD          ; Retrieve next defender value
1295:	0FE8  20F4    	        JR      NZ,XC15         ; Jump if none
1296:	0FEA  08      	XC18:   EX      af,af'          ; Save Defender
1297:	0FEB  78      	        LD      a,b             ; Get value of attacked piece
1298:	0FEC  CB41    	XC19:   BIT     0,c             ; Attacker or defender ?
