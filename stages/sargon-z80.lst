1278:	0FCD  42      	        LD      b,d             ; Save
1279:	0FCE  CDFA0F  	        CALL    NEXTAD          ; Retrieve first attacker
1280:	0FD1  C8      	        RET     Z               ; Return if none
1281:	0FD2  6F      	XC10:   LD      l,a             ; Save attacker value
1282:	0FD3  CDFA0F  	        CALL    NEXTAD          ; Get next defender
1283:	0FD6  2812    	        JR      Z,XC18          ; Jump if none
1284:	0FD8  08      	        EX      af,af'          ; Save defender value
1285:	0FD9  78      	        LD      a,b             ; Get attacked value
