3080:	1F5A  A7      	        AND     a               ; Is square empty ?
3081:	1F5B  287C    	        JR      Z,IP2C          ; Yes - jump
3082:	1F5D  FEFF    	        CP      0FFH            ; Is it a border square ?
3083:	1F5F  2878    	        JR      Z,IP2C          ; Yes - jump
3084:	1F61  0E00    	        LD      c,0             ; Clear flag register
3085:	1F63  CB7F    	        BIT     7,a             ; Is piece white ?
3086:	1F65  2802    	        JR      Z,IP04          ; Yes - jump
3087:	1F67  0E02    	        LD      c,2             ; Set black piece flag
3088:	1F69  E607    	IP04:   AND     7               ; Delete flags, leave piece
3089:	1F6B  3D      	        DEC     a               ; Piece on a 0 - 5 basis
3090:	1F6C  5F      	        LD      e,a             ; Save
3091:	1F6D  1610    	        LD      d,16            ; Multiplier
3092:	1F6F  CD1620  	        CALL    MLTPLY          ; For loc of piece in table
3093:	1F72  7A      	        LD      a,d             ; Displacement into block table
3094:	1F73  325B19  	        LD      (INDXER),a      ; Low order index byte
3095:	1F76  DD2A5B19	        LD      ix,(INDXER)     ; Get entire index
3096:	1F7A  CB46    	        BIT     0,(hl)          ; Is square white ?
3097:	1F7C  2801    	        JR      Z,IP08          ; Yes - jump
3098:	1F7E  0C      	        INC     c               ; Set complement flag
3099:	1F7F  2C      	IP08:   INC     l               ; Address of first alter block
3100:	1F80  E5      	        PUSH    hl              ; Save
3101:	1F81  1600    	        LD      d,0             ; Bar counter
3102:	1F83  0604    	IP0C:   LD      b,4             ; Block counter
3103:	1F85  DD7E80  	IP10:   LD      a,(ix+BLOCK)    ; Bring in source block
3104:	1F88  CB41    	        BIT     0,c             ; Should it be complemented ?
3105:	1F8A  2802    	        JR      Z,IP14          ; No - jump
3106:	1F8C  EE3F    	        XOR     3FH             ; Graphics complement
3107:	1F8E  77      	IP14:   LD      (hl),a          ; Store block
3108:	1F8F  2C      	        INC     l               ; Next block
3109:	1F90  DD23    	        INC     ix              ; Next source block
3110:	1F92  10F1    	        DJNZ    IP10            ; Done ? No - jump
3111:	1F94  7D      	        LD      a,l             ; Bar increment
3112:	1F95  C63C    	        ADD     a,3CH
3113:	1F97  6F      	        LD      l,a
3114:	1F98  14      	        INC     d               ; Bar counter
3115:	1F99  CB52    	        BIT     2,d             ; Done ?
3116:	1F9B  28E6    	        JR      Z,IP0C          ; No - jump
3117:	1F9D  E1      	        POP     hl              ; Address of Norm + 1
3118:	1F9E  CB41    	        BIT     0,c             ; Is square white ?
3119:	1FA0  2006    	        JR      NZ,IP18         ; No - jump
3120:	1FA2  CB49    	        BIT     1,c             ; Is piece white ?
3121:	1FA4  2033    	        JR      NZ,IP2C         ; No - jump
3122:	1FA6  1804    	        JR      IP1C            ; Jump
3123:	1FA8  CB49    	IP18:   BIT     1,c             ; Is piece white ?
3124:	1FAA  282D    	        JR      Z,IP2C          ; Yes - jump
3125:	1FAC  1606    	IP1C:   LD      d,6             ; Multiplier
3126:	1FAE  CD1620  	        CALL    MLTPLY          ; Multiply for displacement
3127:	1FB1  7A      	        LD      a,d             ; Kernel table displacement
3128:	1FB2  325B19  	        LD      (INDXER),a      ; Save
3129:	1FB5  DD2A5B19	        LD      ix,(INDXER)     ; Get complete index
3130:	1FB9  7D      	        LD      a,l             ; Start of Kernel
3131:	1FBA  C640    	        ADD     a,40H
3132:	1FBC  6F      	        LD      l,a
3133:	1FBD  1600    	        LD      d,0             ; Bar counter
3134:	1FBF  0603    	IP20:   LD      b,3             ; Block counter
3135:	1FC1  DD7EF0  	IP24:   LD      a,(ix+KERNEL)   ; Kernel block
3136:	1FC4  CB49    	        BIT     1,c             ; Need to complement ?
3137:	1FC6  2002    	        JR      NZ,IP28         ; No - jump
3138:	1FC8  EE3F    	        XOR     3FH             ; Graphics complement
3139:	1FCA  77      	IP28:   LD      (hl),a          ; Store block
3140:	1FCB  2C      	        INC     l               ; Next target block
3141:	1FCC  DD23    	        INC     ix              ; Next source block
3142:	1FCE  10F1    	        DJNZ    IP24            ; Done ? No - jump
3143:	1FD0  7D      	        LD      a,l             ; Bar increment
3144:	1FD1  C63D    	        ADD     a,3DH
3145:	1FD3  6F      	        LD      l,a
3146:	1FD4  14      	        INC     d               ; Bar counter
