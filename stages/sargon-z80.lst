2377:	1B66  2809    	        JR      Z,rel021        ; No - jump
2378:	1B68' FFB31ABB	        PRTBLK  O_O_O,5         ; Output "O-O-O"
	      180500
2379:	1B6F  1807    	        JR      CP1C            ; Jump
