1945:			;***********************************************************
1946:			; ASCEND TREE ROUTINE
1947:			;***********************************************************
1948:			; FUNCTION:  --  To adjust all necessary parameters to
1949:			;                ascend one ply in the tree.
1950:			;
1951:			; CALLED BY: --  FNDMOV
1952:			;
1953:			; CALLS:     --  UNMOVE
1954:			;
1955:			; ARGUMENTS: --  None
1956:			;***********************************************************
1957:	1408  212100  	ASCEND: LD      hl,COLOR        ; Toggle color
1958:	140B  3E80    	        LD      a,80H
1959:	140D  AE      	        XOR     (hl)
1960:	140E  77      	        LD      (hl),a          ; Save new color
1961:	140F  CB7F    	        BIT     7,a             ; Is it white ?
1962:	1411  2804    	        JR      Z,rel019        ; Yes - jump
1963:	1413  212600  	        LD      hl,MOVENO       ; Decrement move number
1964:	1416  35      	        DEC     (hl)
1965:	1417  2A1800  	rel019: LD      hl,(SCRIX)      ; Load score table index
1966:	141A  2B      	        DEC     hl              ; Decrement
1967:	141B  221800  	        LD      (SCRIX),hl      ; Save
1968:	141E  212800  	        LD      hl,NPLY         ; Decrement ply counter
1969:	1421  35      	        DEC     (hl)
1970:	1422  2A1400  	        LD      hl,(MLPTRI)     ; Load ply list pointer
1971:	1425  2B      	        DEC     hl              ; Load pointer to move list top
1972:	1426  56      	        LD      d,(hl)
1973:	1427  2B      	        DEC     hl
1974:	1428  5E      	        LD      e,(hl)
1975:	1429  ED531E00	        LD      (MLNXT),de      ; Update move list avail ptr
1976:	142D  2B      	        DEC     hl              ; Get ptr to next move to undo
1977:	142E  56      	        LD      d,(hl)
1978:	142F  2B      	        DEC     hl
1979:	1430  5E      	        LD      e,(hl)
1980:	1431  221400  	        LD      (MLPTRI),hl     ; Save new ply list pointer
1981:	1434  ED531600	        LD      (MLPTRJ),de     ; Save next move pointer
1982:	1438  CDE311  	        CALL    UNMOVE          ; Restore board to previous ply
1983:	143B  C9      	        RET                     ; Return
1984:			
1985:			;***********************************************************
1986:			; ONE MOVE BOOK OPENING
1987:			; **********************************************************
1988:			; FUNCTION:   --  To provide an opening book of a single
1989:			;                 move.
1990:			;
1991:			; CALLED BY:  --  FNDMOV
1992:			;
1993:			; CALLS:      --  None
1994:			;
1995:			; ARGUMENTS:  --  None
1996:			;***********************************************************
1997:	143C  F1      	BOOK:   POP     af              ; Abort return to FNDMOV
1998:	143D  215401  	        LD      hl,SCORE+1      ; Zero out score
1999:	1440  3600    	        LD      (hl),0          ; Zero out score table
2000:	1442  213200  	        LD      hl,BMOVES-2     ; Init best move ptr to book
2001:	1445  221A00  	        LD      (BESTM),hl
2002:	1448  211A00  	        LD      hl,BESTM        ; Initialize address of pointer
2003:	144B  3A2000  	        LD      a,(KOLOR)       ; Get computer's color
2004:	144E  A7      	        AND     a               ; Is it white ?
2005:	144F  2009    	        JR      NZ,BM5          ; No - jump
2006:	1451  ED5F    	        LD      a,r             ; Load refresh reg (random no)
2007:	1453  CB47    	        BIT     0,a             ; Test random bit
2008:	1455  C8      	        RET     Z               ; Return if zero (P-K4)
2009:	1456  34      	        INC     (hl)            ; P-Q4
2010:	1457  34      	        INC     (hl)
2011:	1458  34      	        INC     (hl)
2012:	1459  C9      	        RET                     ; Return
2013:	145A  34      	BM5:    INC     (hl)            ; Increment to black moves
2014:	145B  34      	        INC     (hl)
2015:	145C  34      	        INC     (hl)
2016:	145D  34      	        INC     (hl)
2017:	145E  34      	        INC     (hl)
2018:	145F  34      	        INC     (hl)
2019:	1460  DD2A1600	        LD      ix,(MLPTRJ)     ; Pointer to opponents 1st move
2020:	1464  DD7E02  	        LD      a,(ix+MLFRP)    ; Get "from" position
2021:	1467  FE16    	        CP      22              ; Is it a Queen Knight move ?
2022:	1469  280C    	        JR      Z,BM9           ; Yes - Jump
2023:	146B  FE1B    	        CP      27              ; Is it a King Knight move ?
2024:	146D  2808    	        JR      Z,BM9           ; Yes - jump
2025:	146F  FE22    	        CP      34              ; Is it a Queen Pawn ?
2026:	1471  2804    	        JR      Z,BM9           ; Yes - jump
2027:	1473  D8      	        RET     C               ; If Queen side Pawn opening -
2028:			                                ; return (P-K4)
2029:	1474  FE23    	        CP      35              ; Is it a King Pawn ?
2030:	1476  C8      	        RET     Z               ; Yes - return (P-K4)
2031:	1477  34      	BM9:    INC     (hl)            ; (P-Q4)
2032:	1478  34      	        INC     (hl)
2033:	1479  34      	        INC     (hl)
2034:	147A  C9      	        RET                     ; Return to CPTRMV
