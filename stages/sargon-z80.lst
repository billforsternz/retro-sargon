3291:			;***********************************************************
3292:			; EXECUTE MOVE SUBROUTINE
3293:			;***********************************************************
3294:			; FUNCTION:   --  This routine is the control routine for
3295:			;                 MAKEMV. It checks for double moves and
3296:			;                 sees that they are properly handled. It
3297:			;                 sets flags in the B register for double
3298:			;                 moves:
3299:			;                       En Passant -- Bit 0
3300:			;                       O-O        -- Bit 1
3301:			;                       O-O-O      -- Bit 2
3302:			;
3303:			; CALLED BY:   -- PLYRMV
3304:			;                 CPTRMV
3305:			;
3306:			; CALLS:       -- MAKEMV
3307:			;
3308:			; ARGUMENTS:   -- Flags set in the B register as described
3309:			;                 above.
3310:			;***********************************************************
3311:	205E  DDE5    	EXECMV: PUSH    ix              ; Save registers
3312:	2060  F5      	        PUSH    af
3313:	2061  DD2A1600	        LD      ix,(MLPTRJ)     ; Index into move list
3314:	2065  DD4E02  	        LD      c,(ix+MLFRP)    ; Move list "from" position
3315:	2068  DD5E03  	        LD      e,(ix+MLTOP)    ; Move list "to" position
3316:	206B  CDA220  	        CALL    MAKEMV          ; Produce move
3317:	206E  DD5604  	        LD      d,(ix+MLFLG)    ; Move list flags
3318:	2071  0600    	        LD      b,0
3319:	2073  CB72    	        BIT     6,d             ; Double move ?
3320:	2075  2827    	        JR      Z,EX14          ; No - jump
3321:	2077  110600  	        LD      de,6            ; Move list entry width
3322:	207A  DD19    	        ADD     ix,de           ; Increment MLPTRJ
3323:	207C  DD4E02  	        LD      c,(ix+MLFRP)    ; Second "from" position
3324:	207F  DD5E03  	        LD      e,(ix+MLTOP)    ; Second "to" position
3325:	2082  7B      	        LD      a,e             ; Get "to" position
3326:	2083  B9      	        CP      c               ; Same as "from" position ?
3327:	2084  2003    	        JR      NZ,EX04         ; No - jump
3328:	2086  04      	        INC     b               ; Set en passant flag
3329:	2087  1812    	        JR      EX10            ; Jump
3330:	2089  FE1A    	EX04:   CP      1AH             ; White O-O ?
3331:	208B  2004    	        JR      NZ,EX08         ; No - jump
3332:	208D  CBC8    	        SET     1,b             ; Set O-O flag
3333:	208F  180A    	        JR      EX10            ; Jump
3334:	2091  FE60    	EX08:   CP      60H             ; Black 0-0 ?
3335:	2093  2004    	        JR      NZ,EX0C         ; No - jump
3336:	2095  CBC8    	        SET     1,b             ; Set 0-0 flag
3337:	2097  1802    	        JR      EX10            ; Jump
3338:	2099  CBD0    	EX0C:   SET     2,b             ; Set 0-0-0 flag
3339:	209B  CDA220  	EX10:   CALL    MAKEMV          ; Make 2nd move on board
3340:	209E  F1      	EX14:   POP     af              ; Restore registers
3341:	209F  DDE1    	        POP     ix
3342:	20A1  C9      	        RET                     ; Return
3343:			
3344:			;***********************************************************
3345:			; MAKE MOVE SUBROUTINE
3346:			;***********************************************************
3347:			; FUNCTION:   --  Moves the piece on the board when a move
3348:			;                 is made. It blinks both the "from" and
3349:			;                 "to" positions to give notice of the move.
3350:			;
3351:			; CALLED BY:  --  EXECMV
3352:			;
3353:			; CALLS:      --  CONVRT
3354:			;                 BLNKER
3355:			;                 INSPCE
3356:			;
3357:			; ARGUMENTS:  --  The "from" position is passed in register
3358:			;                 C, and the "to" position in register E.
3359:			;***********************************************************
3360:	20A2  F5      	MAKEMV: PUSH    af              ; Save register
3361:	20A3  C5      	        PUSH    bc
3362:	20A4  D5      	        PUSH    de
3363:	20A5  E5      	        PUSH    hl
3364:	20A6  79      	        LD      a,c             ; "From" position
3365:	20A7  325919  	        LD      (BRDPOS),a      ; Set up parameter
3366:	20AA  CDE01F  	        CALL    CONVRT          ; Getting Norm address in HL
3367:	20AD  060A    	        LD      b,10            ; Blink parameter
3368:	20AF  CD2720  	        CALL    BLNKER          ; Blink "from" square
3369:	20B2  7E      	        LD      a,(hl)          ; Bring in Norm 1plock
3370:	20B3  2C      	        INC     l               ; First change block
3371:	20B4  1600    	        LD      d,0             ; Bar counter
3372:	20B6  0604    	MM04:   LD      b,4             ; Block counter
3373:	20B8  77      	MM08:   LD      (hl),a          ; Insert blank block
3374:	20B9  2C      	        INC     l               ; Next change block
3375:	20BA  10FC    	        DJNZ    MM08            ; Done ? No - jump
3376:	20BC  4F      	        LD      c,a             ; Saving norm block
3377:	20BD  7D      	        LD      a,l             ; Bar increment
3378:	20BE  C63C    	        ADD     a,3CH
3379:	20C0  6F      	        LD      l,a
3380:	20C1  79      	        LD      a,c             ; Restore Norm block
3381:	20C2  14      	        INC     d
3382:	20C3  CB52    	        BIT     2,d             ; Done ?
3383:	20C5  28EF    	        JR      Z,MM04          ; No - jump
3384:	20C7  7B      	        LD      a,e             ; Get "to" position
3385:	20C8  325919  	        LD      (BRDPOS),a      ; Set up parameter
3386:	20CB  CDE01F  	        CALL    CONVRT          ; Getting Norm address in HL
3387:	20CE  060A    	        LD      b,10            ; Blink parameter
3388:	20D0  CD471F  	        CALL    INSPCE          ; Inserts the piece
3389:	20D3  CD2720  	        CALL    BLNKER          ; Blinks "to" square
3390:	20D6  E1      	        POP     hl              ; Restore registers
3391:	20D7  D1      	        POP     de
3392:	20D8  C1      	        POP     bc
3393:	20D9  F1      	        POP     af
3394:	20DA  C9      	        RET                     ; Return
