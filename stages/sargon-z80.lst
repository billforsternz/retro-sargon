2404:			;***********************************************************
2405:			; FORCED MATE HANDLING
2406:			;***********************************************************
2407:			; FUNCTION:   --  To examine situations where there exits
2408:			;                 a forced mate and determine whether or
2409:			;                 not the current move is checkmate. If it is,
2410:			;                 a losing player is offered another game,
2411:			;                 while a loss for the computer signals the
2412:			;                 King to tip over in resignation.
2413:			;
2414:			; CALLED BY:  --  CPTRMV
2415:			;
2416:			; CALLS:      --  MATED
2417:			;                 CHARTR
2418:			;                 TBPLMV
2419:			;
2420:			; ARGUMENTS:  --  The only value passed in a register is the
2421:			;                 flag which tells FCDMAT whether the computer
2422:			;                 or the player is mated.
2423:			;***********************************************************
2424:	1BAF  3A2600  	FCDMAT: LD      a,(MOVENO)      ; Current move number
2425:	1BB2  47      	        LD      b,a             ; Save
2426:	1BB3  3A2500  	        LD      a,(PMATE)       ; Move number where mate occurs
2427:	1BB6  90      	        SUB     b               ; Number of moves till mate
2428:	1BB7  A7      	        AND     a               ; Checkmate ?
2429:	1BB8  2040    	        JR      NZ,FM0C         ; No - jump
2430:	1BBA  CB41    	        BIT     0,c             ; Check flag for who is mated
2431:	1BBC  2818    	        JR      Z,FM04          ; Jump if player
2432:	1BBE' FF921A00	        CARRET                  ; New line
	      00
2433:	1BC3' FFB21AC0	        PRTLIN  CKMSG,9         ; Print "CHECKMATE"
	      180900
2434:	1BCA  CD7C1D  	        CALL    MATED           ; Tip over King
2435:	1BCD' FFB21AD4	        PRTLIN  UWIN,7          ; Output "YOU WIN"
	      180700
2436:	1BD4  180E    	        JR      FM08            ; Jump
2437:	1BD6' FFB21AC5	FM04:   PRTLIN  MTMSG,4         ; Output "MATE"
	      180400
2438:	1BDD' FFB21ADB	        PRTLIN  IWIN,5          ; Output "I WIN"
	      180500
2439:	1BE4  E1      	FM08:   POP     hl              ; Remove return addresses
2440:	1BE5  E1      	        POP     hl
2441:	1BE6  CD431D  	        CALL    CHARTR          ; Input any char to play again
2442:	1BE9' FFB21A3C	FM09:   CLRSCR                  ; Blank screen
	      190100
2443:	1BF0' FFB21AE0	        PRTLIN  AGAIN,22        ; "CARE FOR ANOTHER GAME?"
	      181600
2444:	1BF7  C3111A  	        JP      DRIV01          ; Jump (Rest of game init)
2445:	1BFA  CB41    	FM0C:   BIT     0,c             ; Who has forced mate ?
2446:	1BFC  C0      	        RET     NZ              ; Return if player
2447:	B0FF␀ 1A041917	        CARRET                  ; New line
