2052:	0184  80A09080	        DB      $80,$A0,$90,$80
2053:	0188  80AF9F80	        DB      $80,$AF,$9F,$80
2054:	018C  80838380	        DB      $80,$83,$83,$80
2055:	0190  80B0B080	        DB      $80,$B0,$B0,$80 ; Black Knight on White square
2056:	0194  BEBFBF95	        DB      $BE,$BF,$BF,$95
2057:	0198  A0BEBF85	        DB      $A0,$BE,$BF,$85
2058:	019C  83838381	        DB      $83,$83,$83,$81
2059:	01A0  80A00080	        DB      $80,$A0,$00,$80 ; Black Bishop on White square
2060:	01A4  A8BFBD80	        DB      $A8,$BF,$BD,$80
2061:	01A8  82AF8780	        DB      $82,$AF,$87,$80
2062:	01AC  82838380	        DB      $82,$83,$83,$80
2063:	01B0  80808080	        DB      $80,$80,$80,$80 ; Black Rook on White square
2064:	01B4  8ABEBD85	        DB      $8A,$BE,$BD,$85
2065:	01B8  80BFBF80	        DB      $80,$BF,$BF,$80
2066:	01BC  82838381	        DB      $82,$83,$83,$81
2067:	01C0  90808090	        DB      $90,$80,$80,$90 ; Black Queen on White square
2068:	01C4  BFB4BE95	        DB      $BF,$B4,$BE,$95
2069:	01C8  8BBF9F81	        DB      $8B,$BF,$9F,$81
2070:	01CC  83838381	        DB      $83,$83,$83,$81
2071:	01D0  80B89080	        DB      $80,$B8,$90,$80 ; Black King on White square
2072:	01D4  BCBAB894	        DB      $BC,$BA,$B8,$94
2073:	01D8  AFBFBF85	        DB      $AF,$BF,$BF,$85
2074:	01DC  83838381	        DB      $83,$83,$83,$81
2075:	01E0  90B0B080	        DB      $90,$B0,$B0,$80 ; Toppled Black King
2076:	01E4  BFBFB780	        DB      $BF,$BF,$B7,$80
2077:	01E8  9FBFBD80	        DB      $9F,$BF,$BD,$80
2078:	01EC  8080889D	        DB      $80,$80,$88,$9D
2079:	FFF0          	KERNEL  EQU     $-BLBASE
