3235:			;***********************************************************
3236:			; SQUARE BLINKER
3237:			;***********************************************************
3238:			;
3239:			; FUNCTION:   --  To blink the graphics board square to signal
3240:			;                 a piece's intention to move, or to high-
3241:			;                 light the square as being alterable
3242:			;                 in ANALYS.
3243:			;
3244:			; CALLED BY:  --  MAKEMV
3245:			;                 ANALYS
3246:			;                 MATED
3247:			;
3248:			; CALLS:      --  None
3249:			;
3250:			; ARGUMENTS:  --  Norm address of desired square passed in register
3251:			;                 pair HL. Number of times to blink passed in
3252:			;                 register B.
3253:			;***********************************************************
3254:	2027  F5      	BLNKER: PUSH    af              ; Save registers
3255:	2028  C5      	        PUSH    bc
3256:	2029  D5      	        PUSH    de
3257:	202A  E5      	        PUSH    hl
3258:	202B  DDE5    	        PUSH    ix
3259:	202D  225D19  	        LD      (NORMAD),hl     ; Save Norm address
3260:	2030  1600    	BL04:   LD      d,0             ; Bar counter
3261:	2032  0E00    	BL08:   LD      c,0             ; Block counter
3262:	2034  7E      	BL0C:   LD      a,(hl)          ; Fetch block
3263:	2035  EE3F    	        XOR     3FH             ; Graphics complement
3264:	2037  77      	        LD      (hl),a          ; Replace block
3265:	2038  2C      	        INC     l               ; Next block address
3266:	2039  0C      	        INC     c               ; Increment block counter
3267:	203A  79      	        LD      a,c
3268:	203B  FE06    	        CP      6               ; Done ?
3269:	203D  20F5    	        JR      NZ,BL0C         ; No - jump
3270:	203F  7D      	        LD      a,l             ; Address
3271:	2040  C63A    	        ADD     a,3AH           ; Adjust square position
3272:	2042  6F      	        LD      l,a             ; Replace address
3273:	2043  14      	        INC     d               ; Increment bar counter
3274:	2044  CB52    	        BIT     2,d             ; Done ?
3275:	2046  28EA    	        JR      Z,BL08          ; No - jump
3276:	2048  2A5D19  	        LD      hl,(NORMAD)     ; Get Norm address
3277:	204B  C5      	        PUSH    bc              ; Save register
3278:	204C  013030  	        LD      bc,3030H        ; Delay loop, for visibility
3279:	204F  10FE    	BL10:   DJNZ    BL10
3280:	2051  0D      	        DEC     c
3281:	2052  20FB    	        JR      NZ,BL10
3282:	2054  C1      	        POP     bc              ; Restore register
3283:	2055  10D9    	        DJNZ    BL04            ; Done ? No - jump
3284:	2057  DDE1    	        POP     ix              ; Restore registers
3285:	2059  E1      	        POP     hl
3286:	205A  D1      	        POP     de
3287:	205B  C1      	        POP     bc
3288:	205C  F1      	        POP     af
3289:	205D  C9      	        RET                     ; Return
