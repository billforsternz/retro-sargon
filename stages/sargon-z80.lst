	      B99F
2082:	01FC  97BE96BD	        DB      $97,$BE,$96,$BD,$9B,$B9 ; Bishop Kernel
	      9BB9
2083:	0202  B5A192BF	        DB      $B5,$A1,$92,$BF,$AA,$95 ; Rook Kernel
	      AA95
2084:	0208  A89BB9B6	        DB      $A8,$9B,$B9,$B6,$AF,$A7 ; Queen Kernel
	      AFA7
