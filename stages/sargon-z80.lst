2143:			;*******************************************************
2144:			; MACRO DEFINITIONS
2145:			;*******************************************************
2146:			; All input/output to SARGON is handled in the form of
2147:			; macro calls to simplify conversion to alternate systems.
2148:			; All of the input/output macros conform to the Jove monitor
2149:			; of the Jupiter III computer.
2150:			;*******************************************************
2151:			;*** OUTPUT <CR><LF> ***
2152:			CARRET  MACRO
2153:			        RST     38h
2154:			        DB      92H,1AH
2155:			        DW      0
2156:			        ENDM
2157:			
2158:			;*** CLEAR SCREEN ***
2159:			CLRSCR  MACRO
2160:			        RST     38h
2161:			        DB      0B2H,1AH
2162:			        DW      BLANKR,1
2163:			        ENDM
2164:			
2165:			;*** PRINT ANY LINE (NAME, LENGTH) ***
2166:			PRTLIN  MACRO   NAME,LNGTH
2167:			        RST     38h
2168:			        DB      0B2H,1AH
2169:			        DW      NAME,LNGTH
2170:			        ENDM
2171:			
2172:			;*** PRINT ANY BLOCK (NAME, LENGTH) ***
2173:			PRTBLK  MACRO   NAME,LNGTH
2174:			        RST     38h
2175:			        DB      0B3H,1AH
2176:			        DW      NAME,LNGTH
2177:			        ENDM
2178:			
2179:			;*** EXIT TO MONITOR ***
2180:			EXIT    MACRO
2181:			        RST     38h
2182:			        DB      01FH
2183:			        ENDM
2184:			
2185:			;***********************************************************
2186:			; MAIN PROGRAM DRIVER
2187:			;***********************************************************
2188:			; FUNCTION:   --  To coordinate the game moves.
2189:			;
2190:			; CALLED BY:  --  None
2191:			;
2192:			; CALLS:      --  INTERR
2193:			;                 INITBD
2194:			;                 DSPBRD
2195:			;                 CPTRMV
2196:			;                 PLYRMV
2197:			;                 TBCPCL
2198:			;                 PGIFND
2199:			;
2200:			; MACRO CALLS:    CLRSCR
2201:			;                 CARRET
2202:			;                 PRTLIN
2203:			;                 PRTBLK
2204:			;
2205:			; ARGUMENTS:      None
2206:			;***********************************************************
2207:	1A00          	        ORG     START+1A00H     ; Above the move logic
2208:	1A00  31FF02  	DRIVER: LD      sp,STACK        ; Set stack pointer
2209:	1A03' FFB21A3C	        CLRSCR                  ; Blank out screen
	      190100
2210:	1A0A' FFB21A00	        PRTLIN  GRTTNG,34       ; Output greeting
	      182200
2211:	1A11  CD431D  	DRIV01: CALL    CHARTR          ; Accept answer
2212:	1A14' FF921A00	        CARRET                  ; New line
	      00
2213:	1A19  FE59    	        CP      59H             ; Is it a 'Y' ?
2214:	1A1B  C2B81D  	        JP      NZ,ANALYS       ; Yes - jump
2215:	1A1E  97      	        SUB     a               ; Code of White is zero
2216:	1A1F  322100  	        LD      (COLOR),a       ; White always moves first
2217:	1A22  CDB91A  	        CALL    INTERR          ; Players color/search depth
2218:	1A25  CD000B  	        CALL    INITBD          ; Initialize board array
2219:	1A28  3E01    	        LD      a,1             ; Move number is 1 at at start
2220:	1A2A  322600  	        LD      (MOVENO),a      ; Save
2221:	1A2D  325F19  	        LD      (LINECT),a      ; Line number is one at start
2222:	1A30  218618  	        LD      hl,MVENUM       ; Address of ascii move number
2223:	1A33  3630    	        LD      (hl),30H        ; Init to '01 '
2224:	1A35  23      	        INC     hl
2225:	1A36  3631    	        LD      (hl),31H
2226:	1A38  23      	        INC     hl
2227:	1A39  3620    	        LD      (hl),20H
2228:	1A3B  CDDB1E  	        CALL    DSPBRD          ; Set up graphics board
2229:	1A3E' FFB21A1B	        PRTLIN  TITLE4,15       ; Put up player headings
	      190F00
2230:	1A45' FFB21A89	        PRTLIN  TITLE3,15
	      180F00
2231:	1A4C' FFB31A86	DRIV04: PRTBLK  MVENUM,3        ; Display move number
	      180300
2232:	1A53  3A2000  	        LD      a,(KOLOR)       ; Bring in computer's color
2233:	1A56  A7      	        AND     a               ; Is it white ?
2234:	1A57  201C    	        JR      NZ,DR08         ; No - jump
2235:	1A59  CD5D1D  	        CALL    PGIFND          ; New page if needed
2236:	1A5C  FE01    	        CP      1               ; Was page turned ?
2237:	1A5E  CC261C  	        CALL    Z,TBCPCL        ; Yes - Tab to computers column
2238:	1A61  CD211B  	        CALL    CPTRMV          ; Make and write computers move
2239:	1A64' FFB31A7C	        PRTBLK  SPACE,1         ; Output a space
	      180100
2240:	1A6B  CD711C  	        CALL    PLYRMV          ; Accept and make players move
2241:	1A6E' FF921A00	        CARRET                  ; New line
	      00
2242:	1A73  181A    	        JR      DR0C            ; Jump
2243:	1A75  CD711C  	DR08:   CALL    PLYRMV          ; Accept and make players move
2244:	1A78' FFB31A7C	        PRTBLK  SPACE,1         ; Output a space
	      180100
2245:	1A7F  CD5D1D  	        CALL    PGIFND          ; New page if needed
2246:	1A82  FE01    	        CP      1               ; Was page turned ?
2247:	1A84  CC261C  	        CALL    Z,TBCPCL        ; Yes - Tab to computers column
2248:	1A87  CD211B  	        CALL    CPTRMV          ; Make and write computers move
2249:	1A8A' FF921A00	        CARRET                  ; New line
	      00
2250:	1A8F  218818  	DR0C:   LD      hl,MVENUM+2     ; Addr of 3rd char of move
2251:	1A92  3E20    	        LD      a,20H           ; Ascii space
2252:	1A94  BE      	        CP      (hl)            ; Is char a space ?
2253:	1A95  3E3A    	        LD      a,3AH           ; Set up test value
2254:	1A97  2806    	        JR      Z,DR10          ; Yes - jump
2255:	1A99  34      	        INC     (hl)            ; Increment value
2256:	1A9A  BE      	        CP      (hl)            ; Over Ascii 9 ?
2257:	1A9B  2015    	        JR      NZ,DR14         ; No - jump
2258:	1A9D  3630    	        LD      (hl),30H        ; Set char to zero
2259:	1A9F  2B      	DR10:   DEC     hl              ; 2nd char of Ascii move no.
2260:	1AA0  34      	        INC     (hl)            ; Increment value
2261:	1AA1  BE      	        CP      (hl)            ; Over Ascii 9 ?
2262:	1AA2  200E    	        JR      NZ,DR14         ; No - jump
2263:	1AA4  3630    	        LD      (hl),30H        ; Set char to zero
2264:	1AA6  2B      	        DEC     hl              ; 1st char of Ascii move no.
2265:	1AA7  34      	        INC     (hl)            ; Increment value
2266:	1AA8  BE      	        CP      (hl)            ; Over Ascii 9 ?
2267:	1AA9  2007    	        JR      NZ,DR14         ; No - jump
2268:	1AAB  3631    	        LD      (hl),31H        ; Make 1st char a one
2269:	1AAD  3E30    	        LD      a,30H           ; Make 3rd char a zero
2270:	1AAF  328818  	        LD      (MVENUM+2),a
2271:	1AB2  212600  	DR14:   LD      hl,MOVENO       ; Hexadecimal move number
2272:	1AB5  34      	        INC     (hl)            ; Increment
2273:	1AB6  C34C1A  	        JP      DRIV04          ; Jump
